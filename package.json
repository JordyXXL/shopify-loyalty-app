{
  "name": "loyalty-discounted-product",
  "private": true,
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "vitest run",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "deploy:hetzner": "./deploy.sh",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs shopify-loyalty-app",
    "pm2:status": "pm2 status",
    "db:backup": "pg_dump -h localhost -U loyalty_user loyalty_app_prod | gzip > backup_$(date +%Y%m%d_%H%M%S).sql.gz",
    "db:restore": "gunzip -c $1 | psql -h localhost -U loyalty_user loyalty_app_prod",
    "logs:view": "tail -f logs/combined.log",
    "logs:error": "tail -f logs/err.log",
    "health:check": "curl -f http://localhost:3000/health || echo 'Health check failed'",
    "cron:install": "crontab crontab.txt && echo 'Cron jobs installed'",
    "cron:list": "crontab -l",
    "db:migrate": "node scripts/migrate.js migrate",
    "db:health": "node scripts/migrate.js health",
    "db:cleanup": "node scripts/migrate.js cleanup",
    "deploy:do": "doctl apps create --spec .do/app.yaml",
    "deploy:check": "curl -f $SHOPIFY_APP_URL/health || echo 'Health check failed'"
  },
  "type": "module",
  "engines": {
    "node": "^18.20 || ^20.10 || >=21.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/fs-routes": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.10",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-app-remix": "^3.7.0",
    "@shopify/shopify-app-session-storage-prisma": "^6.0.0",
    "isbot": "^5.1.0",
    "randomstring": "^1.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.16.1",
    "@remix-run/route-config": "^2.16.1",
    "@shopify/api-codegen-preset": "^1.1.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.2.0",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.2.4",
    "prisma": "^6.16.3",
    "typescript": "^5.2.2",
    "vite": "^6.2.2",
    "vitest": "3.2.4"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16"
  },
  "author": "QF Network"
}
